rules_version = '2';

// ============================================================
// Find4U — Firestore Security Rules
// מחליף את ברירת המחדל. בלי הקובץ הזה כל לקוח יכול למחוק/לשנות מוצרים.
// פריסה: Firebase Console → Firestore Database → Rules → הדבק ושמור
//        (או: firebase deploy --only firestore:rules)
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // האדמין מזוהה לפי המייל בטוקן של Firebase Auth (לא לפי נתון שהלקוח שולח)
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'asafg999@gmail.com';
    }

    // ---------- מוצרים ----------
    match /products/{productId} {
      allow read: if true;

      // יצירה ומחיקה — אדמין בלבד
      allow create, delete: if isAdmin();

      // עדכון: אדמין יכול הכל; משתמש מחובר יכול לשנות *רק* את likesCount
      allow update: if isAdmin() ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']));

      // ---------- ביקורות על מוצר ----------
      match /reviews/{reviewId} {
        allow read: if true;

        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        // מוחקים: הכותב או האדמין
        allow delete: if isAdmin() ||
          (isSignedIn() && resource.data.userId == request.auth.uid);

        allow update: if isAdmin();
      }
    }

    // ---------- קליקים יוצאים ----------
    // דף המעבר /go/[id] רושם הקלקה לכל יציאה לאליאקספרס. הלקוח כותב בלבד;
    // קריאה של הנתונים היא לאדמין, כדי שלא יהיה אפשר לדלות מהם מידע.
    match /clicks/{clickId} {
      allow create: if request.resource.data.keys().hasOnly(
        ['productId', 'slug', 'name', 'category', 'price', 'referer', 'createdAt']
      );
      allow read, update, delete: if isAdmin();
    }

    // ---------- קטגוריות ----------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- משתמשים ----------
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      // משתמש לא יכול להפוך את עצמו לאדמין
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.isAdmin == false;

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && (!('isAdmin' in request.resource.data) ||
            request.resource.data.isAdmin == resource.data.isAdmin);

      allow delete: if isAdmin();

      // מוצרים שאהבתי — רק הבעלים
      match /likedProducts/{productId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }
  }
}

# הרצה מקומית של הצינור (לא לגיט את .env עצמו):
#   cp video/.env.example video/.env      # וממלאים
#   cd video && node --env-file=.env scripts/render.js
#
# --- Gemini TTS (המנוע הראשון, הקול העברי הטבעי) ------------------------
# מפתח מ-AI Studio (aistudio.google.com → Get API key). הוא לא עובד מול
# Cloud TTS, ולהפך. מכסת Free Tier: 10 בקשות ביום לכל מודל, ולכן כל
# התסריט נשלח בבקשה אחת ומפוצל מקומית לפי שקטים (scripts/audio-split.js).
# סרטון אחד = בקשה אחת. אם נגמרת המכסה של flash-tts, ננסה flash-lite-tts.
GEMINI_API_KEY=

# אופציונלי: קול. אנרגטיים: Sadachbia (ברירת מחדל, נשי תוסס), Fenrir (גברי
# מתלהב), Zephyr (נשי בהיר), Puck (גברי אופטימי), Aoede (נשי קליל).
# GEMINI_TTS_VOICE=Sadachbia

# מודל ומודל גיבוי כשהמכסה היומית נגמרת.
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-lite-tts

# קצב. אין speakingRate ב-Gemini — ההאצה נעשית ב-Remotion עם preservePitch.
# GEMINI_TTS_SPEED=1.12

# בקשה לכל משפט (מדויק יותר, אבל 10 בקשות לסרטון — רק בחשבון בתשלום).
# GEMINI_TTS_PER_SENTENCE=1

# --- Google Cloud Text-to-Speech (גיבוי) --------------------------------
# מפתח API מפרויקט שבו Cloud Text-to-Speech API מופעל.
GOOGLE_TTS_API_KEY=

# אופציונלי: קול עברי אחר. ברירת המחדל היא he-IL-Wavenet-A (אישה).
# גבריים: he-IL-Wavenet-B / he-IL-Wavenet-D. נשיים: he-IL-Wavenet-C.
# GOOGLE_TTS_VOICE=he-IL-Wavenet-B

# --- Firebase ------------------------------------------------------------
# נוח מקומית: נתיב לקובץ ה-JSON של Service Account
# (Firebase Console → Project settings → Service accounts → Generate new private key).
# שומרים את הקובץ בתיקיית video/ (הוא ב-.gitignore) ולא בקומיט.
FIREBASE_SERVICE_ACCOUNT_FILE=serviceAccount.json

# חלופה ל-CI: ה-JSON כולו כשורה אחת
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# --- הפקת סרטון בדיקה ----------------------------------------------------
# מזהה או slug של מוצר ספציפי (עוקף את "המוצר הבא בתור").
# REEL_PRODUCT=led-791021

# לא לדרוס את הקובץ המפורסם ב-public/videos בזמן בדיקה.
REEL_SKIP_PUBLISH_COPY=1

# --- אופציונלי -----------------------------------------------------------
# TTS_PROVIDER=google
# TTS_SPEED=1
# SITE_URL=https://find4u.vercel.app
